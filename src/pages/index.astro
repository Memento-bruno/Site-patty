---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Reconhecer from '../components/Reconhecer.astro';
import Terapia from '../components/Terapia.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Sobre from '../components/Sobre.astro';
import Agendar from '../components/Agendar.astro';
import Duvidas from '../components/Duvidas.astro';
import Rodape from '../components/Rodape.astro';
import BarraAgendamento from '../components/BarraAgendamento.astro';
---
<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Reconhecer />
    <Terapia />
    <ComoFunciona />
    <Sobre />
    <Agendar />
    <Duvidas />
  </main>
  <Rodape />
  <BarraAgendamento />
</Base>
