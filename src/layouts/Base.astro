---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/literata/wght.css';
import '../styles/global.css';

/* Só o arquivo usado no H1 é pré-carregado (briefing 9.3). */
import fonteTitulo from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

import { profissional, links, seo } from '../data/site';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descricao?: string;
  /* Páginas de serviço (404) ficam fora do sitemap e da indexação. */
  indexar?: boolean;
}

const {
  titulo = seo.titulo,
  descricao = seo.descricao,
  indexar = true,
} = Astro.props;

const canonica = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const imagemOg = new URL(url(seo.og), Astro.site).href;

const perfis = [links.vittude, links.instagram, links.google].filter(
  (valor): valor is string => typeof valor === 'string' && valor.length > 0,
);

/* JSON-LD: só dados factuais. Sem aggregateRating e sem review (briefing 9.1). */
const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profissional.nomeCompleto,
  jobTitle: profissional.titulo,
  identifier: profissional.crp,
  knowsLanguage: 'pt-BR',
  url: canonica.href,
  sameAs: perfis,
};
---

<!doctype html>
<html lang={seo.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica.href} />
    {!indexar && <meta name="robots" content="noindex, follow" />}

    <meta name="author" content={profissional.identificacao} />
    <meta name="theme-color" content="#FBFAFC" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={profissional.identificacao} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:image" content={imagemOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profissional.identificacao} — atendimento psicológico online`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemOg} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/favicon.svg')} />

    <link
      rel="preload"
      href={fonteTitulo}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link rel="preconnect" href="https://vittude.com" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(dadosEstruturados)}
    />
  </head>

  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
