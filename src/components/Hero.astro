---
import Foto from './Foto.astro';
import SeloCRP from './SeloCRP.astro';
import Icone from './Icone.astro';
import Essencial from './Essencial.astro';
import { hero, botoes, whatsappUrl } from '../data/site';
---
<section id="inicio" class="hero">
  <div class="container">
    <div class="hero__caixa">
      <div class="hero__grade">
        <div class="hero__texto">
          <p class="intro hero__identificacao">{hero.identificacao}</p>
          <h1>{hero.titulo}</h1>
          <p class="hero__paragrafo">{hero.paragrafo}</p>

          <div class="hero__acoes">
            <a class="botao botao--primario" href="#agendar">{botoes.agendar}</a>

            <a class="hero__whats" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <span class="hero__whats-icone">
                <Icone nome="whatsapp-logo" tamanho="1.375rem" />
              </span>
              <span>{botoes.whatsapp}<span class="so-leitor"> (abre em nova aba)</span></span>
            </a>
          </div>
        </div>

        <div class="hero__media">
          <Foto
            nome="hero"
            alt={hero.foto.alt}
            legendaPlaceholder={hero.foto.legendaPlaceholder}
            formato="arco"
            prioridade={true}
            class="hero__foto"
          />
          <div class="hero__selo"><SeloCRP /></div>
        </div>
      </div>

      <Essencial />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: var(--e-6); }

  /* O único degradê do site. */
  .hero__caixa {
    position: relative;
    border-radius: var(--r-hero);
    background: linear-gradient(150deg, var(--lilas-100) 0%, var(--papel) 62%);
    padding: var(--e-8) var(--e-6) 0;
  }

  .hero__grade {
    display: grid;
    gap: var(--e-8);
  }

  .hero__identificacao { margin-bottom: var(--e-4); }

  .hero h1 { max-width: 18ch; }

  .hero__paragrafo {
    margin-top: var(--e-6);
    max-width: 46ch;
    color: var(--texto-suave);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-6);
    margin-top: var(--e-8);
  }

  .hero__acoes .botao { flex: 1 1 100%; }

  /* Ocupa o lugar do "Watch More" da referência: ícone em círculo + rótulo. */
  .hero__whats {
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 3rem;
    font-family: var(--fonte-titulo);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ameixa-900);
    text-decoration: none;
  }

  .hero__whats-icone {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border: 1px solid var(--ameixa-600);
    border-radius: var(--r-pilula);
    color: var(--ameixa-600);
    transition: background-color 150ms ease;
  }

  .hero__whats:hover { text-decoration: underline; }
  .hero__whats:hover .hero__whats-icone { background: var(--lilas-100); }

  .hero__media {
    position: relative;
    max-width: min(18rem, 60vh * 0.8);
    margin-inline: auto;
    width: 100%;
  }

  .hero__selo {
    position: absolute;
    left: 0;
    top: 38%;
    transform: translateX(-38%);
  }

  @media (min-width: 48rem) {
    .hero { padding-top: var(--e-8); }

    .hero__caixa { padding: var(--e-16) var(--e-12) 0; }

    .hero__acoes .botao { flex: 0 0 auto; }

    .hero__grade {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--e-8);
      align-items: center;
    }

    .hero__texto { grid-column: 1 / 8; }

    .hero__media {
      grid-column: 8 / 13;
      max-width: none;
      margin-inline: 0;
    }

    .hero__selo {
      top: 32%;
      transform: translateX(-46%);
    }
  }

  @media (min-width: 64rem) {
    .hero__grade { gap: var(--e-12); }
  }
</style>
