---
import Foto from './Foto.astro';
import SeloCRP from './SeloCRP.astro';
import Icone from './Icone.astro';
import Essencial from './Essencial.astro';
import { hero, botoes, whatsappUrl } from '../data/site';
---
<section id="inicio" class="hero">
  <div class="hero__banda">
    <div class="container hero__grade">
      <div class="hero__texto">
        <p class="intro hero__identificacao">{hero.identificacao}</p>
        <h1>{hero.titulo}</h1>
        <p class="hero__paragrafo">{hero.paragrafo}</p>

        <div class="hero__acoes">
          <a class="botao botao--primario" href="#agendar">{botoes.agendar}</a>

          <a class="hero__whats" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <span class="hero__whats-icone">
              <Icone nome="whatsapp-logo" tamanho="1.375rem" />
            </span>
            <span>{botoes.whatsapp}<span class="so-leitor"> (abre em nova aba)</span></span>
          </a>
        </div>
      </div>

      <div class="hero__media">
        <Foto
          nome="hero"
          alt={hero.foto.alt}
          legendaPlaceholder={hero.foto.legendaPlaceholder}
          formato="arco"
          prioridade={true}
          class="hero__foto"
        />
        <div class="hero__selo"><SeloCRP /></div>
      </div>
    </div>
  </div>

  <div class="container">
    <Essencial />
  </div>
</section>

<style>
  /* A faixa do hero vai de borda a borda da tela, em vez da caixa
     arredondada da referência: a caixa com cantos de 32 px e degradê é o
     traço mais reconhecível daquela família de templates. Aqui o fundo
     malva é uma faixa lisa, e os três cartões ficam montados sobre a linha
     onde ela termina. É o único lugar do site com um degradê, bem curto,
     para a faixa não terminar numa aresta dura atrás dos cartões. */
  .hero__banda {
    background: linear-gradient(to bottom, var(--lilas-100) 0%, var(--lilas-100) 88%, var(--papel) 100%);
    padding-top: var(--e-8);
    padding-bottom: var(--e-16);
  }

  .hero__grade {
    display: grid;
    gap: var(--e-8);
  }

  .hero__identificacao { margin-bottom: var(--e-4); }

  .hero h1 { max-width: 19ch; }

  .hero__paragrafo {
    margin-top: var(--e-6);
    max-width: 44ch;
    color: var(--texto-suave);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-6);
    margin-top: var(--e-8);
  }

  .hero__acoes .botao { flex: 1 1 100%; }

  /* Ocupa o lugar do "Watch More" da referência: ícone em círculo + rótulo. */
  .hero__whats {
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 3rem;
    font-family: var(--fonte-rotulo);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ameixa-900);
    text-decoration: none;
  }

  .hero__whats-icone {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border: 1px solid var(--ameixa-600);
    border-radius: var(--r-pilula);
    color: var(--ameixa-600);
    transition: background-color 150ms ease;
  }

  .hero__whats:hover { text-decoration: underline; }
  .hero__whats:hover .hero__whats-icone { background: var(--papel); }

  .hero__media {
    position: relative;
    max-width: min(18rem, 60vh * 0.8);
    margin-inline: auto;
    width: 100%;
  }

  .hero__selo {
    position: absolute;
    left: 0;
    top: 38%;
    transform: translateX(-38%);
  }

  @media (min-width: 48rem) {
    .hero__banda {
      padding-top: var(--e-12);
      padding-bottom: var(--e-24);
    }

    .hero__acoes .botao { flex: 0 0 auto; }

    .hero__grade {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--e-8);
      align-items: center;
    }

    .hero__texto { grid-column: 1 / 8; }

    .hero__media {
      grid-column: 8 / 13;
      max-width: none;
      margin-inline: 0;
    }

    .hero__selo {
      top: 32%;
      transform: translateX(-46%);
    }
  }

  @media (min-width: 64rem) {
    .hero__banda { padding-top: var(--e-16); }
    .hero__grade { gap: var(--e-12); }
    .hero__texto { grid-column: 1 / 7; }
    .hero__media { grid-column: 8 / 13; }
  }
</style>
