---
import { terapia } from '../data/site';
---
<section class="secao faixa-lilas terapia">
  <div class="container">
    <h2>{terapia.titulo}</h2>
    <p class="terapia__abertura">{terapia.paragrafo}</p>

    <div class="terapia__colunas">
      {
        [terapia.e, terapia.naoE].map((coluna) => (
          <div class="terapia__coluna">
            <h3>{coluna.titulo}</h3>
            <ul>
              {coluna.itens.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="terapia__metodo">
      <h3>{terapia.comoTrabalho.titulo}</h3>
      <p>{terapia.comoTrabalho.texto}</p>
    </div>

    <p class="terapia__final">{terapia.fraseFinal}</p>
  </div>
</section>

<style>
  .terapia__abertura {
    margin-top: var(--e-6);
    max-width: 62ch;
  }

  .terapia__colunas {
    display: grid;
    gap: var(--e-8);
    margin-top: var(--e-12);
  }

  .terapia__coluna h3 { margin-bottom: var(--e-4); }

  .terapia__coluna ul {
    list-style: none;
    display: grid;
    gap: var(--e-3);
  }

  .terapia__coluna li {
    padding-left: var(--e-6);
    position: relative;
    color: var(--texto-suave);
  }

  /* Um traço curto, não um marcador redondo: a lista de arcos é da outra seção. */
  .terapia__coluna li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: var(--e-3);
    height: 1px;
    background: var(--ameixa-600);
  }

  .terapia__metodo {
    margin-top: var(--e-12);
    padding-top: var(--e-8);
    border-top: 1px solid var(--linha);
  }

  .terapia__metodo p {
    margin-top: var(--e-4);
    max-width: 62ch;
  }

  .terapia__final {
    margin-top: var(--e-8);
    max-width: 52ch;
    color: var(--texto-suave);
    font-size: 1.0625rem;
  }

  @media (min-width: 48rem) {
    .terapia__colunas {
      grid-template-columns: 1fr 1fr;
      gap: var(--e-12);
    }

    /* A régua vertical que separa "É" de "Não é" */
    .terapia__coluna + .terapia__coluna {
      border-left: 1px solid var(--linha);
      padding-left: var(--e-12);
    }
  }
</style>
