---
import { terapia } from '../data/site';
---
<section class="secao faixa-lilas terapia">
  <div class="container">
    <h2>{terapia.titulo}</h2>
    <p class="terapia__abertura">{terapia.paragrafo}</p>

    <div class="terapia__combinados">
      <h3>{terapia.combinados.titulo}</h3>
      <dl class="combinados" data-revelar data-revelar-grupo>
        {
          terapia.combinados.itens.map((item) => (
            <div class="combinados__item">
              <dt>{item.termo}</dt>
              <dd>{item.texto}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="terapia__metodo">
      <h3>{terapia.comoTrabalho.titulo}</h3>
      <p>{terapia.comoTrabalho.texto}</p>
    </div>

    <p class="terapia__final">{terapia.fraseFinal}</p>
  </div>
</section>

<style>
  .terapia__abertura {
    margin-top: var(--e-6);
    max-width: 62ch;
  }

  .terapia__combinados { margin-top: var(--e-12); }

  /* Quatro pares termo/explicação, separados por fio. Sem cartão: a seção
     já está numa faixa de fundo, e cartão dentro de faixa é o padrão de
     template que o plano de design evita. */
  .combinados {
    margin: var(--e-6) 0 0;
    display: grid;
    border-top: 1px solid var(--linha);
  }

  .combinados__item {
    display: grid;
    gap: var(--e-2);
    padding-block: var(--e-6);
    border-bottom: 1px solid var(--linha);
  }

  .combinados dt {
    font-family: var(--fonte-rotulo);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ameixa-900);
  }

  .combinados dd {
    margin: 0;
    color: var(--texto-suave);
    max-width: 48ch;
  }

  .terapia__metodo {
    margin-top: var(--e-12);
    max-width: 62ch;
  }

  .terapia__metodo p { margin-top: var(--e-4); }

  .terapia__final {
    margin-top: var(--e-12);
    max-width: 46ch;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ameixa-900);
  }

  @media (min-width: 48rem) {
    .combinados {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--e-12);
    }

    .terapia__final { font-size: 1.375rem; }
  }
</style>
