---
import Marca from './Marca.astro';
import { profissional } from '../data/site';
import { url } from '../lib/url';

interface Props {
  href?: string;
  class?: string;
}

const { href = url('/'), class: classe } = Astro.props;
---
<a href={href} class:list={['logo', classe]}>
  <Marca variante="simbolo" altura="3rem" traco={15} class="logo__marca" />
  <span class="logo__texto">
    <span class="logo__nome">{profissional.nomeUso}</span>
    <span class="logo__crp">{profissional.titulo}, {profissional.crp}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 3rem;
    text-decoration: none;
    color: inherit;
    padding-block: var(--e-1);
  }

  /* :global porque a classe vai para dentro do componente Marca.
     A marca herda a cor do texto, então acompanha a faixa escura sozinha. */
  .logo :global(.logo__marca) {
    color: var(--ameixa-900);
    flex: none;
  }

  .em-ameixa .logo :global(.logo__marca) { color: var(--texto-claro); }

  .logo__texto {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  /* O nome vem tipografado, e não do manuscrito da logo: no tamanho do
     cabeçalho o manuscrito fica ilegível. Ele aparece inteiro no rodapé. */
  .logo__nome {
    font-family: var(--fonte-titulo);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ameixa-900);
  }

  .em-ameixa .logo__nome { color: var(--texto-claro); }

  .logo__crp {
    font-family: var(--fonte-titulo);
    font-size: var(--t-pequeno);
    font-weight: 500;
    color: var(--texto-suave);
  }
</style>
