---
import Foto from './Foto.astro';
import Texto from './Texto.astro';
import { sobre, profissional, links, botoes } from '../data/site';
---
<section id="sobre" class="secao sobre">
  <div class="container sobre__grade">
    <div class="sobre__media">
      <Foto
        nome="sobre"
        alt={sobre.foto.alt}
        legendaPlaceholder={sobre.foto.legendaPlaceholder}
        formato="retangulo"
      />
    </div>

    <div class="sobre__corpo">
      <h2>{sobre.titulo}</h2>

      <div class="sobre__texto">
        {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
      </div>

      <p class="sobre__identificacao">
        <strong>{profissional.identificacao}</strong>
        <a href={links.cadastroCfp} target="_blank" rel="noopener noreferrer">
          {botoes.verificarCrp}<span class="so-leitor"> (abre em nova aba)</span>
        </a>
      </p>

      <h3 class="sobre__subtitulo">{sobre.formacao.titulo}</h3>
      <dl class="formacao">
        {
          sobre.formacao.itens.map((item) => (
            <div class="formacao__item">
              <dt>{item.periodo ?? ''}</dt>
              <dd>
                <span class="formacao__curso">{item.curso}</span>
                {item.instituicao && (
                  <span class="formacao__instituicao"><Texto valor={item.instituicao} /></span>
                )}
                {item.andamento && <span class="formacao__estado">Em andamento</span>}
                {item.nota && <span class="formacao__nota">{item.nota}</span>}
              </dd>
            </div>
          ))
        }
      </dl>

      <h3 class="sobre__subtitulo">{sobre.temas.titulo}</h3>
      <p class="sobre__temas">{sobre.temas.itens.join(', ')}.</p>
    </div>
  </div>
</section>

<style>
  .sobre__grade { display: grid; gap: var(--e-8); }

  .sobre__media { max-width: 20rem; }

  .sobre__texto {
    display: grid;
    gap: var(--e-4);
    margin-top: var(--e-6);
  }

  .sobre__identificacao {
    margin-top: var(--e-8);
    padding-top: var(--e-6);
    border-top: 1px solid var(--linha);
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    font-size: 1.0625rem;
  }

  .sobre__identificacao strong { font-family: var(--fonte-titulo); }
  .sobre__identificacao a {
    display: inline-flex;
    align-items: center;
    align-self: start;
    min-height: 3rem;
    font-size: var(--t-pequeno);
  }

  .sobre__subtitulo { margin-top: var(--e-12); }

  .formacao {
    margin: var(--e-6) 0 0;
    display: grid;
    gap: var(--e-6);
  }

  .formacao__item {
    display: grid;
    gap: var(--e-1);
    padding-bottom: var(--e-6);
    border-bottom: 1px solid var(--linha);
  }

  .formacao__item:last-child { border-bottom: 0; padding-bottom: 0; }

  .formacao dt {
    font-family: var(--fonte-titulo);
    font-size: var(--t-pequeno);
    font-weight: 600;
    color: var(--texto-suave);
  }

  .formacao dd { margin: 0; display: grid; gap: var(--e-1); }

  .formacao__curso { font-size: 1.0625rem; }

  .formacao__instituicao,
  .formacao__estado,
  .formacao__nota {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  /* Curso em andamento nunca aparece como concluído (briefing 2). */
  .formacao__estado { font-family: var(--fonte-titulo); font-weight: 600; }

  .sobre__temas { margin-top: var(--e-4); color: var(--texto-suave); }

  @media (min-width: 48rem) {
    .sobre__grade {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--e-12) var(--e-8);
      align-items: start;
    }

    .sobre__media {
      grid-column: 1 / 6;
      max-width: none;
    }

    .sobre__corpo { grid-column: 6 / 13; }

    .formacao__item {
      grid-template-columns: 7rem 1fr;
      gap: var(--e-4);
    }
  }
</style>
