---
import Icone from './Icone.astro';
import { links, whatsappUrl } from '../data/site';
---
<nav class="barra" aria-label="Agendar sessão">
  <a class="barra__acao" href={links.vittude} target="_blank" rel="noopener noreferrer">
    <Icone nome="calendar-blank" tamanho="1.375rem" />
    Vittude<span class="so-leitor"> — ver horários (abre em nova aba)</span>
  </a>
  <a class="barra__acao" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
    <Icone nome="whatsapp-logo" tamanho="1.375rem" />
    WhatsApp<span class="so-leitor"> — chamar (abre em nova aba)</span>
  </a>
</nav>

<style>
  /* Agendamento a um toque em qualquer ponto da rolagem, no celular. */
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--linha);
    border-top: 1px solid var(--linha);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .barra__acao {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3.5rem;
    background: var(--papel);
    color: var(--ameixa-900);
    font-family: var(--fonte-titulo);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
  }

  .barra__acao:first-child {
    background: var(--ameixa-900);
    color: var(--texto-claro);
  }

  /* Enquanto o menu do celular está aberto, a barra sai de cena. */
  :global(.menu-aberto) .barra { display: none; }

  @media (min-width: 48rem) {
    .barra { display: none; }
  }
</style>
