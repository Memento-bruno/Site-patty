---
/* Ícones Phosphor (regular) copiados como SVG para src/icons/.
   Sem dependência em tempo de execução: o SVG entra direto no HTML. */
interface Props {
  nome: string;
  tamanho?: string;
  class?: string;
}

const { nome, tamanho = '1.5rem', class: classe } = Astro.props;

const arquivos = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const bruto = arquivos[`../icons/${nome}.svg`];
if (!bruto) throw new Error(`Ícone não encontrado em src/icons/: ${nome}.svg`);

const svg = bruto.replace(
  '<svg ',
  `<svg aria-hidden="true" focusable="false" width="${tamanho}" height="${tamanho}"${classe ? ` class="${classe}"` : ''} `,
);
---
<Fragment set:html={svg} />
