---
import Icone from './Icone.astro';
import Texto from './Texto.astro';
import { duvidas, botoes, whatsappUrl } from '../data/site';
---
<section id="duvidas" class="secao">
  <div class="container">
    <h2>{duvidas.titulo}</h2>

    <div class="duvidas__lista" data-revelar>
      {
        duvidas.itens.map((item) => (
          <details class="duvida">
            <summary>
              <span>{item.pergunta}</span>
              <Icone nome="caret-down" tamanho="1.25rem" class="duvida__seta" />
            </summary>
            <p><Texto valor={item.resposta} /></p>
          </details>
        ))
      }
    </div>

    <p class="duvidas__fechamento">
      {duvidas.fechamento}{' '}
      <a class="botao botao--primario" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        <Icone nome="whatsapp-logo" />
        {botoes.whatsapp}<span class="so-leitor"> (abre em nova aba)</span>
      </a>
    </p>
  </div>
</section>

<style>
  .duvidas__lista {
    margin-top: var(--e-8);
    max-width: 47.5rem;
  }

  /* <details> nativo: sem JavaScript. Cada pergunta é uma caixa que se
     abre ao toque. */
  .duvidas__lista { display: grid; gap: var(--e-3); }

  .duvida {
    border: 1px solid var(--lilas-200);
    border-radius: 12px;
    background: var(--papel);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .duvida:hover { border-color: var(--ameixa-600); }
  .duvida[open] { border-color: var(--ameixa-600); background: var(--lilas-100); }

  .duvida summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    min-height: 3.5rem;
    padding: var(--e-4) var(--e-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--fonte-titulo);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ameixa-900);
    border-radius: 12px;
  }

  .duvida summary::-webkit-details-marker { display: none; }

  .duvida :global(.duvida__seta) {
    flex: none;
    color: var(--ameixa-600);
    transition: transform 150ms ease;
  }

  .duvida[open] :global(.duvida__seta) { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .duvida :global(.duvida__seta) { transition: none; }
  }

  .duvida p {
    padding: 0 var(--e-6) var(--e-6);
    color: var(--texto-suave);
  }

  .duvidas__fechamento {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4);
    margin-top: var(--e-8);
    max-width: 47.5rem;
  }
</style>
