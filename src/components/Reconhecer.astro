---
import Arco from './Arco.astro';
import { reconhecer } from '../data/site';
---
<section id="terapia" class="secao reconhecer">
  <div class="container reconhecer__grade">
    <h2 class="reconhecer__titulo">{reconhecer.titulo}</h2>

    <div class="reconhecer__corpo">
      <ul class="reconhecer__lista">
        {
          reconhecer.itens.map((item) => (
            <li>
              <Arco class="reconhecer__marcador" tamanho="1.125rem" traco={20} />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <p class="reconhecer__fechamento">{reconhecer.fechamento}</p>
    </div>
  </div>
</section>

<style>
  .reconhecer__grade { display: grid; gap: var(--e-8); }

  .reconhecer__lista {
    list-style: none;
    display: grid;
    gap: var(--e-6);
  }

  .reconhecer__lista li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--e-4);
    align-items: start;
  }

  /* O arco ocre como marcador: segunda das três aparições da assinatura. */
  .reconhecer__lista :global(.reconhecer__marcador) {
    color: var(--ocre-500);
    margin-top: 0.55em;
  }

  .reconhecer__fechamento {
    margin-top: var(--e-8);
    padding-top: var(--e-8);
    border-top: 1px solid var(--linha);
    color: var(--texto-suave);
  }

  @media (min-width: 48rem) {
    .reconhecer__grade {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--e-8) var(--e-6);
    }

    .reconhecer__titulo { grid-column: 1 / 6; }
    .reconhecer__corpo { grid-column: 6 / 13; }

    .reconhecer__lista {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--e-6) var(--e-8);
    }

    .reconhecer__fechamento { max-width: 62ch; }
  }
</style>
