---
import Arco from './Arco.astro';
import { reconhecer } from '../data/site';
---
<section id="terapia" class="secao reconhecer">
  <div class="container reconhecer__grade">
    <h2 class="reconhecer__titulo">{reconhecer.titulo}</h2>

    <div class="reconhecer__corpo">
      <ul class="reconhecer__lista" data-revelar data-revelar-grupo>
        {
          reconhecer.itens.map((item) => (
            <li>
              <Arco class="reconhecer__marcador" tamanho="1.125rem" traco={20} />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <p class="reconhecer__fechamento">{reconhecer.fechamento}</p>
    </div>
  </div>
</section>

<style>
  .reconhecer__grade { display: grid; gap: var(--e-8); }

  /* Uma coluna só, frases em corpo maior, separadas por fio: lê como uma
     lista de situações para reconhecer, não como grade de "benefícios". */
  .reconhecer__lista {
    list-style: none;
    display: grid;
  }

  .reconhecer__lista li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--e-4);
    align-items: start;
    padding-block: var(--e-4);
    border-top: 1px solid var(--linha);
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ameixa-900);
  }

  .reconhecer__lista li:last-child { border-bottom: 1px solid var(--linha); }

  /* O arco ocre como marcador: segunda das duas aparições da assinatura. */
  .reconhecer__lista :global(.reconhecer__marcador) {
    color: var(--ocre-500);
    margin-top: 0.5em;
  }

  .reconhecer__fechamento {
    margin-top: var(--e-8);
    color: var(--texto-suave);
  }

  @media (min-width: 48rem) {
    .reconhecer__grade {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--e-8) var(--e-6);
    }

    .reconhecer__titulo { grid-column: 1 / 5; max-width: 12ch; }
    .reconhecer__corpo { grid-column: 5 / 13; }

    .reconhecer__lista li {
      padding-block: var(--e-6);
      font-size: 1.375rem;
    }

    .reconhecer__fechamento { max-width: 58ch; }
  }
</style>
